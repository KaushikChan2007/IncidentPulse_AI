# IncidentPulse AI Environment Variables
# GEMINI_API_KEY: Used by the server to inspect repositories, analyze dependencies, and synthesize incident verdicts.
# In AI Studio, this is automatically injected at runtime.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

TINYFISH_API_KEY="MY_TINYFISH_API_KEY"

# APP_URL: Optional replay target. Set this to your deployed app URL when needed.
APP_URL="http://localhost:3000"
